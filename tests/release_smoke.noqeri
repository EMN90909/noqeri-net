import "../src/net.noqeri"

function require(ok: bool): void {
    if !ok { let invalid: *u8 = 0 as *u8 print(invalid[0]) }
}

let address = [49 as u8, 57 as u8, 50 as u8, 46 as u8, 48 as u8, 46 as u8, 50 as u8, 46 as u8, 49 as u8]
require(netPortValid(443))
require(!netPortValid(0))
require(netIpv4TextValid(address))
print("noqeri-net package tests: OK")

